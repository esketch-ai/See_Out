  "description": "배웅 (Bae-ung) 라이프엔딩 종합 플랫폼",
  "type": "module",
  "scripts": {
    "themis:integrity": "node -e 'import(\"./tools/themis-ai/build/para/manager.js\").then(async m => console.log(await m.validateParaIntegrity()))'",
